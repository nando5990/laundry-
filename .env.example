# Phase 1 demo banners (marketing). Keep true unless you want them hidden.
VITE_DEMO_MODE=true

# Phase 2 API — when set, /book + portal + admin talk to the Node server.
# Leave unset to force demo fallback on the marketing site alone.
VITE_API_URL=http://localhost:8787

# Optional Stripe publishable key (test mode) for future Elements wiring
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
