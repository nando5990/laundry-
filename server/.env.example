# Plain PostgreSQL (Docker Compose, Neon, RDS, or Supabase-Postgres-as-host — schema is portable SQL)
DATABASE_URL=postgres://freshfold:freshfold@localhost:5432/freshfold

PORT=8787
CORS_ORIGIN=http://localhost:5173
SESSION_SECRET=dev-change-me-to-a-long-random-string

# Stripe test mode (optional — SetupIntent stubs if missing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Publishable key is for the Vite frontend (.env)

# Resend transactional email (optional — logs if missing)
RESEND_API_KEY=
EMAIL_FROM=FreshFold <bookings@freshfold.example>
